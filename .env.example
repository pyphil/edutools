# Copy this file to .env and adjust the values for your local environment.

# To generate a new secret key:
# python manage.py shell
# >>> from django.core.management.utils import get_random_secret_key
# >>> get_random_secret_key()

# Django settings
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Email settings
EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Links in registration/password reset mails use https (set False only for local development)
EMAIL_LINKS_USE_HTTPS=True
# Validity of registration links in hours
ACCOUNTS_REGISTRATION_LINK_TIMEOUT_HOURS=48
# Set True if a reverse proxy terminates TLS and sends X-Forwarded-Proto
USE_SECURE_PROXY_SSL_HEADER=False
# Optional log file for e-mail errors (otherwise logged to the web server error log)
# LOG_FILE=/var/log/edutools/edutools.log

# CSRF Configuration for Docker (adjust domain as needed)
# CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1